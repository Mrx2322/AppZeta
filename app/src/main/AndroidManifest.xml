        <activity
            android:name=".usuario.menus.ActivityTodosLosMenus"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".splash.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.AppZetaR.Splash"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".splash.IntroVideoActivity"
