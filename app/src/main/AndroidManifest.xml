<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppZetaR">

        <activity
            android:name=".usuario.perfilusuario.ActivityPerfilUsuario"
            android:exported="false" />

        <activity
            android:name=".usuario.pedidos.ActivityPedidosUsuario"
            android:exported="false" />

        <activity
            android:name=".usuario.extras.ActivityExtras"
            android:exported="false" />

        <activity
            android:name=".usuario.entregas.ActivityDireccion"
            android:exported="false" />

        <activity
            android:name=".usuario.entregas.ActivityEntrega"
            android:exported="false"
