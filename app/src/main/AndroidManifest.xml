<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppZetaR">

        <activity
            android:name=".Usuario.ActivityPerfilUsuario"
            android:exported="false" />

        <activity
            android:name=".Usuario.ActivityPedidosUsuario"
            android:exported="false" />

        <activity
            android:name=".Usuario.ActivityExtras"
            android:exported="false" />

        <activity
            android:name=".Usuario.ActivityDireccion"
            android:exported="false" />

        <activity
            android:name=".Usuario.ActivityEntrega"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Usuario.ActivityConfirmarPedido"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Usuario.RegistroActivity"
            android:exported="false" />

        <activity
            android:name=".Usuario.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Usuario.Pagos.ActivityPagoYape"
            android:exported="false" />

        <activity
            android:name=".Usuario.Confirmacion.ActivityResumenPedido"
            android:exported="false" />

        <activity
            android:name=".Usuario.Confirmacion.ActivityDatosPedido"
            android:exported="false" />

        <activity
            android:name=".Usuario.Carrito.ActivityPedido"
            android:exported="false" />

        <activity
            android:name=".Usuario.ActivityMenuUsuario"
            android:exported="false"
            android:theme="@style/Theme.AppZetaR.MenuUsuario"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".splash.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.AppZetaR.Splash"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>