<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    tools:context=".Usuario.ActivityExtras">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- TÍTULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extras"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Completa tu pedido con algo extra"
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- CATEGORÍAS -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategorias"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="18dp"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />

        <!-- TÍTULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Elige tus extras"
            android:textColor="#222222"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- EXTRAS -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExtras"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="10dp"
            tools:listitem="@layout/item_extra" />

        <!-- SIN EXTRAS -->

        <TextView
            android:id="@+id/tvSinExtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="No hay extras disponibles"
            android:textColor="#888888"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- LOADING -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center" />

</FrameLayout>