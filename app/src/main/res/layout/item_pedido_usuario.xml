<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/cardPedidoUsuario"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="2dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="10dp"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"

    app:strokeColor="#EAEAEA"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">


        <!-- ================================================= -->
        <!-- INFORMACIÓN SUPERIOR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:baselineAligned="false"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvNumeroPedido"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:ellipsize="end"
                    android:maxLines="1"

                    android:text="@string/pedido_usuario_numero_default"

                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvFechaPedido"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:ellipsize="end"
                    android:maxLines="1"

                    android:text="@string/pedido_usuario_fecha_default"

                    android:textColor="#888888"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ESTADO -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstadoPedido"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="10dp"

                app:cardBackgroundColor="#FFF3E0"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvEstadoPedido"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:ellipsize="end"
                    android:maxLines="1"

                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"

                    android:text="@string/pedido_usuario_estado_pendiente"

                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MENSAJE DEL ESTADO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvMensajeEstado"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:text="@string/pedido_usuario_mensaje_recibido"

            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- SEGUIMIENTO -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutSeguimiento"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="17dp"

            android:baselineAligned="false"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- ================================================= -->
            <!-- RECIBIDO -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicadorRecibido"

                android:layout_width="30dp"
                android:layout_height="30dp"

                app:cardBackgroundColor="#E87520"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvIndicadorRecibido"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="@string/pedido_usuario_paso_completado"

                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>


            <View
                android:id="@+id/lineaConfirmado"

                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:background="#E0E0E0" />


            <!-- ================================================= -->
            <!-- CONFIRMADO -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicadorConfirmado"

                android:layout_width="30dp"
                android:layout_height="30dp"

                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvIndicadorConfirmado"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="@string/pedido_usuario_paso_2"

                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>


            <View
                android:id="@+id/lineaPreparacion"

                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:background="#E0E0E0" />


            <!-- ================================================= -->
            <!-- PREPARACIÓN -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicadorPreparacion"

                android:layout_width="30dp"
                android:layout_height="30dp"

                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvIndicadorPreparacion"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="@string/pedido_usuario_paso_3"

                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>


            <View
                android:id="@+id/lineaDespacho"

                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:background="#E0E0E0" />


            <!-- ================================================= -->
            <!-- DESPACHO -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicadorDespacho"

                android:layout_width="30dp"
                android:layout_height="30dp"

                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvIndicadorDespacho"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="@string/pedido_usuario_paso_4"

                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>


            <View
                android:id="@+id/lineaEntregado"

                android:layout_width="0dp"
                android:layout_height="3dp"

                android:layout_weight="1"

                android:background="#E0E0E0" />


            <!-- ================================================= -->
            <!-- ENTREGADO -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicadorEntregado"

                android:layout_width="30dp"
                android:layout_height="30dp"

                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvIndicadorEntregado"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="@string/pedido_usuario_paso_5"

                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ETIQUETAS DEL SEGUIMIENTO -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutEtiquetasSeguimiento"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="7dp"

            android:baselineAligned="false"

            android:orientation="horizontal">


            <TextView
                android:id="@+id/tvEtiquetaRecibido"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="start"
                android:maxLines="2"

                android:text="@string/pedido_usuario_recibido"

                android:textColor="#E87520"
                android:textSize="11sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvEtiquetaConfirmado"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:maxLines="2"

                android:text="@string/pedido_usuario_confirmado"

                android:textColor="#999999"
                android:textSize="11sp" />


            <TextView
                android:id="@+id/tvEtiquetaPreparacion"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:maxLines="2"

                android:text="@string/pedido_usuario_preparando"

                android:textColor="#999999"
                android:textSize="11sp" />


            <TextView
                android:id="@+id/tvEtiquetaDespacho"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:maxLines="2"

                android:text="@string/pedido_usuario_en_camino"

                android:textColor="#999999"
                android:textSize="11sp" />


            <TextView
                android:id="@+id/tvEtiquetaEntregado"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="end"
                android:maxLines="2"

                android:text="@string/pedido_usuario_entregado"

                android:textColor="#999999"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SEPARADOR -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"

            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"

            android:background="#EEEEEE" />


        <!-- ================================================= -->
        <!-- TOTAL -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:baselineAligned="false"

            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="@string/pedido_usuario_total_titulo"

                android:textColor="#777777"
                android:textSize="13sp" />


            <TextView
                android:id="@+id/tvTotalPedido"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:gravity="end"

                android:text="@string/pedido_usuario_total_default"

                android:textColor="#222222"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>