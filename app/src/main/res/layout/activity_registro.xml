<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/fondo_login"

    android:clipToPadding="false"
    android:fillViewport="true"

    android:overScrollMode="never"

    android:paddingStart="24dp"
    android:paddingTop="35dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center_horizontal"
        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- LOGO -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imgLogoRegistro"

            android:layout_width="112dp"
            android:layout_height="112dp"

            android:contentDescription="@string/registro_logo_descripcion"

            android:scaleType="centerInside"
            android:src="@drawable/log_zeta" />


        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="@string/registro_titulo"

            android:textColor="#202020"
            android:textSize="25sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:gravity="center"

            android:text="@string/registro_subtitulo"

            android:textColor="#777777"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- TARJETA REGISTRO -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"

            app:strokeColor="#EEEEEE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">


                <!-- ================================================= -->
                <!-- TÍTULO FORMULARIO -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/registro_crear_cuenta_titulo"

                    android:textColor="#202020"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="@string/registro_crear_cuenta_subtitulo"

                    android:textColor="#777777"
                    android:textSize="14sp" />


                <!-- ================================================= -->
                <!-- NOMBRE -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:hint="@string/registro_hint_nombre"

                    app:boxBackgroundColor="#FFFCF9"
                    app:boxBackgroundMode="outline"

                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="#E87520">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombre"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:inputType="textPersonName"
                        android:maxLines="1"

                        android:textColor="#202020" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ================================================= -->
                <!-- CORREO -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="13dp"

                    android:hint="@string/registro_hint_correo"

                    app:boxBackgroundColor="#FFFCF9"
                    app:boxBackgroundMode="outline"

                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="#E87520">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreo"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:inputType="textEmailAddress"
                        android:maxLines="1"

                        android:textColor="#202020" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ================================================= -->
                <!-- CONTRASEÑA -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="13dp"

                    android:hint="@string/registro_hint_contrasena"

                    app:boxBackgroundColor="#FFFCF9"
                    app:boxBackgroundMode="outline"

                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="#E87520"

                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etContrasena"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:inputType="textPassword"
                        android:maxLines="1"

                        android:textColor="#202020" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ================================================= -->
                <!-- CONFIRMAR CONTRASEÑA -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="13dp"

                    android:hint="@string/registro_hint_confirmar_contrasena"

                    app:boxBackgroundColor="#FFFCF9"
                    app:boxBackgroundMode="outline"

                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="#E87520"

                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmarContrasena"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:inputType="textPassword"
                        android:maxLines="1"

                        android:textColor="#202020" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ================================================= -->
                <!-- BOTÓN REGISTRO -->
                <!-- ================================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarse"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:layout_marginTop="22dp"

                    android:minHeight="54dp"

                    android:text="@string/registro_boton_crear_cuenta"
                    android:textAllCaps="false"

                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"

                    app:backgroundTint="#E87520"
                    app:cornerRadius="16dp"
                    app:elevation="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- MENSAJE FINAL -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:gravity="center"

            android:text="@string/registro_mensaje_final"

            android:textColor="#777777"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>