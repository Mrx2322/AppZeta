<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"

    tools:context=".Usuario.ActivityMenuUsuario">


    <!-- ===================================================== -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:fillViewport="true"
        android:clipToPadding="false"

        android:paddingTop="55dp"
        android:paddingBottom="105dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- SALUDO -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvSaludo"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:text="¡Hola!"
                android:textColor="#222222"
                android:textSize="26sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="¿Qué deseas comer hoy?"
                android:textColor="#777777"
                android:textSize="15sp" />


            <!-- ================================================= -->
            <!-- ENTRADAS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                android:text="Entradas"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEntradas"

                android:layout_width="match_parent"
                android:layout_height="105dp"

                android:layout_marginTop="10dp"

                android:clipToPadding="false"

                android:paddingStart="2dp"
                android:paddingEnd="2dp"

                tools:listitem="@layout/item_task_entrada_usuario" />


            <!-- ================================================= -->
            <!-- NUESTRO MENÚ -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="Nuestro menú"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Ver todo"
                    android:textColor="#E87520"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMenu"

                android:layout_width="match_parent"
                android:layout_height="285dp"

                android:layout_marginTop="10dp"

                android:clipToPadding="false"

                android:paddingStart="4dp"
                android:paddingEnd="4dp"

                tools:listitem="@layout/item_task_menu_usuario" />


            <!-- ================================================= -->
            <!-- EXTRAS OCULTOS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTituloExtras"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Extras"
                android:visibility="gone" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategorias"

                android:layout_width="match_parent"
                android:layout_height="82dp"

                android:visibility="gone" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExtras"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ===================================================== -->
    <!-- PROGRESS -->
    <!-- ===================================================== -->

    <ProgressBar
        android:id="@+id/progressBarMenu"

        android:layout_width="45dp"
        android:layout_height="45dp"

        android:layout_gravity="center"

        android:visibility="gone" />


    <!-- ===================================================== -->
    <!-- BARRA INFERIOR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="76dp"

        android:layout_gravity="bottom"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"

        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"
            android:orientation="horizontal"

            android:paddingStart="5dp"
            android:paddingEnd="5dp">


            <!-- ================================================= -->
            <!-- INICIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navInicio"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"
                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:src="@drawable/ic_home"

                    android:contentDescription="Inicio" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Inicio"
                    android:textColor="#E87520"
                    android:textSize="11sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="18dp"
                    android:layout_height="3dp"

                    android:layout_marginTop="3dp"

                    android:background="@drawable/bg_nav_indicator" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EXTRAS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navExtras"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"
                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:src="@drawable/ic_extra"

                    android:contentDescription="Extras" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Extras"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PEDIDOS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPedidos"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"
                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:src="@drawable/ic_pedidos"

                    android:contentDescription="Pedidos" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Pedidos"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CARRITO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navCarrito"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"
                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">


                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">


                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"

                        android:layout_gravity="center"

                        android:src="@drawable/ic_carrito"

                        android:contentDescription="Carrito" />


                    <TextView
                        android:id="@+id/tvCantidadCarrito"

                        android:layout_width="16dp"
                        android:layout_height="16dp"

                        android:layout_gravity="top|end"

                        android:background="@drawable/bg_badge_carrito"

                        android:gravity="center"

                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                </FrameLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="1dp"

                    android:text="Carrito"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PERFIL -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPerfil"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"
                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:src="@drawable/ic_perfil"

                    android:contentDescription="Perfil" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Perfil"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- FAB ANTIGUO OCULTO -->
    <!-- ===================================================== -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCarrito"

        android:layout_width="1dp"
        android:layout_height="1dp"

        android:visibility="gone" />

</FrameLayout>