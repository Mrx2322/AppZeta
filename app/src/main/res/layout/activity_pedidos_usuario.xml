<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F7F7F7"

    android:clipChildren="false"
    android:clipToPadding="false"

    tools:context=".usuario.ActivityPedidosUsuario">


    <!-- ===================================================== -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:paddingStart="18dp"
        android:paddingTop="55dp"
        android:paddingEnd="18dp"
        android:paddingBottom="108dp">


        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:cardBackgroundColor="#FFF3E8"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"

            app:strokeColor="#FFE0C2"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:baselineAligned="false"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/tvTituloPedidos"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/pedidos_usuario_titulo"

                        android:textColor="#222222"
                        android:textSize="27sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvSubtituloPedidos"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="@string/pedidos_usuario_subtitulo"

                        android:textColor="#766B64"
                        android:textSize="14sp" />

                </LinearLayout>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="54dp"
                    android:layout_height="54dp"

                    android:layout_marginStart="12dp"

                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="27dp"
                    app:cardElevation="0dp">


                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"

                        android:layout_gravity="center"

                        android:contentDescription="@string/pedidos_usuario_descripcion"

                        android:src="@drawable/ic_pedidos" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- LISTA DE PEDIDOS -->
        <!-- ================================================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_marginTop="14dp"

            android:layout_weight="1">


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPedidos"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:clipToPadding="false"

                android:overScrollMode="never"

                android:paddingTop="3dp"
                android:paddingBottom="10dp"

                android:scrollbars="none" />


            <!-- ================================================= -->
            <!-- CARGANDO -->
            <!-- ================================================= -->

            <ProgressBar
                android:id="@+id/progressBarPedidos"

                android:layout_width="48dp"
                android:layout_height="48dp"

                android:layout_gravity="center"

                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- SIN PEDIDOS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutSinPedidos"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"
                android:orientation="vertical"

                android:padding="28dp"

                android:visibility="gone">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="78dp"
                    android:layout_height="78dp"

                    app:cardBackgroundColor="#FFF3E8"
                    app:cardCornerRadius="39dp"
                    app:cardElevation="0dp">


                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"

                        android:layout_gravity="center"

                        android:contentDescription="@string/pedidos_usuario_sin_pedidos_descripcion"

                        android:src="@drawable/ic_pedidos" />

                </com.google.android.material.card.MaterialCardView>


                <TextView
                    android:id="@+id/tvSinPedidos"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:gravity="center"

                    android:text="@string/pedidos_usuario_sin_pedidos_titulo"

                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:gravity="center"

                    android:text="@string/pedidos_usuario_sin_pedidos_subtitulo"

                    android:textColor="#888888"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- BARRA INFERIOR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="bottom"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:minHeight="76dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"

        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:baselineAligned="false"

            android:clipChildren="false"
            android:clipToPadding="false"

            android:gravity="center"
            android:orientation="horizontal"

            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp">


            <!-- ================================================= -->
            <!-- INICIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navInicio"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_inicio"

                    android:src="@drawable/ic_home" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_inicio"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EXTRAS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navExtras"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_extras"

                    android:src="@drawable/ic_extra" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_extras"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PEDIDOS ACTIVO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPedidos"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_pedidos"

                    android:src="@drawable/ic_pedidos" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_pedidos"

                    android:textColor="#E87520"
                    android:textSize="11sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="18dp"
                    android:layout_height="3dp"

                    android:layout_marginTop="3dp"

                    android:background="@drawable/bg_nav_indicator" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CARRITO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navCarrito"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">


                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp">


                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"

                        android:layout_gravity="center"

                        android:contentDescription="@string/cd_carrito"

                        android:src="@drawable/ic_carrito" />


                    <TextView
                        android:id="@+id/tvCantidadCarrito"

                        android:layout_width="18dp"
                        android:layout_height="18dp"

                        android:layout_gravity="top|end"

                        android:background="@drawable/bg_badge_carrito"

                        android:gravity="center"

                        android:text="@string/contador_cero"

                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="1dp"

                    android:gravity="center"

                    android:text="@string/nav_carrito"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PERFIL -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPerfil"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_perfil"

                    android:src="@drawable/ic_perfil" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_perfil"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>