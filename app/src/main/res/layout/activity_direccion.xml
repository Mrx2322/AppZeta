<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F7F7F7">


    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:clipToPadding="false"
        android:fillViewport="true"

        android:overScrollMode="never"
        android:scrollbars="none"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintWidth_max="640dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="50dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="#FFF3E8"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"

                app:strokeColor="#FFE0C2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/direccion_entrega_titulo"

                        android:textColor="#202020"
                        android:textSize="27sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="@string/direccion_entrega_subtitulo"

                        android:textColor="#766B64"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- UBICACIÓN -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"

                app:strokeColor="#ECECEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="17dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/direccion_entrega_seccion_ubicacion"

                        android:textColor="#202020"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <!-- DIRECCIÓN -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:hint="@string/direccion_entrega_hint_direccion"

                        app:boxBackgroundMode="outline"

                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDireccion"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:inputType="textPostalAddress|textCapSentences"

                            android:maxLines="2" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- REFERENCIA -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:hint="@string/direccion_entrega_hint_referencia"

                        app:boxBackgroundMode="outline"

                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReferencia"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:inputType="textCapSentences"

                            android:maxLines="2" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- DATOS DE CONTACTO -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"

                app:strokeColor="#ECECEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="17dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/direccion_entrega_seccion_contacto"

                        android:textColor="#202020"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:hint="@string/direccion_entrega_hint_telefono"

                        app:boxBackgroundMode="outline"

                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTelefono"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:inputType="phone"

                            android:maxLength="9"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- INFORMACIÓN -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvInfoDelivery"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:paddingStart="4dp"
                android:paddingEnd="4dp"

                android:text="@string/direccion_entrega_info"

                android:textColor="#777777"
                android:textSize="13sp" />


            <!-- ================================================= -->
            <!-- CONTINUAR -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuarDireccion"

                android:layout_width="match_parent"
                android:layout_height="54dp"

                android:layout_marginTop="20dp"

                android:minHeight="48dp"

                android:text="@string/direccion_entrega_continuar_pago"

                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"

                app:backgroundTint="#E87520"
                app:cornerRadius="16dp"
                app:elevation="0dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>