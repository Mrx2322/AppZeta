<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F7F7F7"

    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:clipToPadding="false"
        android:fillViewport="true"

        android:overScrollMode="never"
        android:scrollbars="none"

        android:paddingBottom="108dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="46dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="@string/perfil_titulo"

                android:textColor="#1F1F1F"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="@string/perfil_subtitulo"

                android:textColor="#7A7A7A"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- TARJETA PERFIL -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="26dp"
                app:cardElevation="4dp"

                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center"
                    android:orientation="vertical"

                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="28dp">


                    <!-- INICIAL -->

                    <TextView
                        android:id="@+id/tvInicialPerfil"

                        android:layout_width="88dp"
                        android:layout_height="88dp"

                        android:background="@drawable/bg_avatar_perfil"

                        android:gravity="center"

                        android:text="@string/perfil_inicial_default"

                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold" />


                    <!-- NOMBRE -->

                    <TextView
                        android:id="@+id/tvNombrePerfil"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="18dp"

                        android:gravity="center"

                        android:text="@string/perfil_nombre_default"

                        android:textColor="#1F1F1F"
                        android:textSize="22sp"
                        android:textStyle="bold" />


                    <!-- CORREO -->

                    <TextView
                        android:id="@+id/tvCorreoPerfil"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:gravity="center"

                        android:text="@string/perfil_correo_default"

                        android:textColor="#7A7A7A"
                        android:textSize="14sp" />


                    <!-- ESTADO -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:background="@drawable/bg_chip_estado"

                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"

                        android:text="@string/perfil_cuenta_activa"

                        android:textColor="#E87520"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- OPCIONES -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"

                android:text="@string/perfil_opciones"

                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"

                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical">


                    <!-- ================================================= -->
                    <!-- EDITAR PERFIL -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:id="@+id/opcionEditarPerfil"

                        android:layout_width="match_parent"
                        android:layout_height="72dp"

                        android:background="?attr/selectableItemBackground"

                        android:baselineAligned="false"

                        android:clickable="true"
                        android:focusable="true"

                        android:gravity="center_vertical"
                        android:orientation="horizontal"

                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"

                            android:background="@drawable/bg_icono_perfil"

                            android:gravity="center"

                            android:text="@string/perfil_editar_icono"

                            android:textColor="#E87520"
                            android:textSize="19sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="14dp"

                            android:layout_weight="1"

                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="@string/perfil_editar_titulo"

                                android:textColor="#1F1F1F"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="2dp"

                                android:text="@string/perfil_editar_descripcion"

                                android:textColor="#8A8A8A"
                                android:textSize="12sp" />

                        </LinearLayout>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/perfil_flecha"

                            android:textColor="#BBBBBB"
                            android:textSize="28sp" />

                    </LinearLayout>


                    <!-- DIVISOR -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginStart="76dp"

                        android:background="#F1F1F1" />


                    <!-- ================================================= -->
                    <!-- MIS PEDIDOS -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:id="@+id/opcionPedidosPerfil"

                        android:layout_width="match_parent"
                        android:layout_height="72dp"

                        android:background="?attr/selectableItemBackground"

                        android:baselineAligned="false"

                        android:clickable="true"
                        android:focusable="true"

                        android:gravity="center_vertical"
                        android:orientation="horizontal"

                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"

                            android:background="@drawable/bg_icono_perfil"

                            android:gravity="center"

                            android:text="@string/perfil_pedidos_icono"

                            android:textColor="#E87520"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="14dp"

                            android:layout_weight="1"

                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="@string/perfil_pedidos_titulo"

                                android:textColor="#1F1F1F"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="2dp"

                                android:text="@string/perfil_pedidos_descripcion"

                                android:textColor="#8A8A8A"
                                android:textSize="12sp" />

                        </LinearLayout>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/perfil_flecha"

                            android:textColor="#BBBBBB"
                            android:textSize="28sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CERRAR SESIÓN -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"

                android:layout_width="match_parent"
                android:layout_height="54dp"

                android:layout_marginTop="28dp"

                android:text="@string/perfil_cerrar_sesion"
                android:textAllCaps="false"

                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"

                app:backgroundTint="#E87520"
                app:cornerRadius="16dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ===================================================== -->
    <!-- BARRA INFERIOR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="bottom"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:minHeight="76dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"

        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:baselineAligned="false"

            android:clipChildren="false"
            android:clipToPadding="false"

            android:gravity="center"
            android:orientation="horizontal"

            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp">


            <!-- ================================================= -->
            <!-- INICIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navInicio"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_inicio"

                    android:src="@drawable/ic_home" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_inicio"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EXTRAS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navExtras"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_extras"

                    android:src="@drawable/ic_extra" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_extras"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PEDIDOS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPedidos"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_pedidos"

                    android:src="@drawable/ic_pedidos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_pedidos"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CARRITO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navCarrito"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"

                        android:layout_gravity="center"

                        android:contentDescription="@string/cd_carrito"

                        android:src="@drawable/ic_carrito" />

                    <TextView
                        android:id="@+id/tvCantidadCarrito"

                        android:layout_width="18dp"
                        android:layout_height="18dp"

                        android:layout_gravity="top|end"

                        android:background="@drawable/bg_badge_carrito"

                        android:gravity="center"

                        android:text="@string/contador_cero"

                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="1dp"

                    android:gravity="center"

                    android:text="@string/nav_carrito"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PERFIL -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPerfil"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"
                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_perfil"

                    android:src="@drawable/ic_perfil" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_perfil"

                    android:textColor="#E87520"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="3dp"

                    android:layout_marginTop="3dp"

                    android:background="@drawable/bg_nav_indicator" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>