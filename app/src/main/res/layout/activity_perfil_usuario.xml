<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F7F7F7"

    android:fillViewport="true"
    android:clipToPadding="false">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="46dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">


        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Mi perfil"

            android:textColor="#1F1F1F"
            android:textSize="29sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Administra tu información personal"

            android:textColor="#7A7A7A"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- TARJETA PRINCIPAL -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="4dp"
            app:strokeColor="#F0F0F0"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"
                android:orientation="vertical"

                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">


                <TextView
                    android:id="@+id/tvInicialPerfil"
                    android:layout_width="88dp"
                    android:layout_height="88dp"

                    android:background="@drawable/bg_avatar_perfil"

                    android:gravity="center"

                    android:text="U"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvNombrePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:gravity="center"

                    android:text="Usuario"

                    android:textColor="#1F1F1F"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvCorreoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:gravity="center"

                    android:text="correo@ejemplo.com"

                    android:textColor="#7A7A7A"
                    android:textSize="14sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"

                    android:background="@drawable/bg_chip_estado"

                    android:text="Cuenta activa"
                    android:textColor="#E87520"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- SECCIÓN -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"

            android:text="Opciones"

            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- TARJETA DE OPCIONES -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:strokeColor="#F0F0F0"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- ============================================= -->
                <!-- EDITAR PERFIL -->
                <!-- ============================================= -->

                <LinearLayout
                    android:id="@+id/opcionEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"

                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"

                    android:gravity="center_vertical"
                    android:orientation="horizontal"

                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">


                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:background="@drawable/bg_icono_perfil"

                        android:gravity="center"

                        android:text="✎"
                        android:textColor="#E87520"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="Editar perfil"

                            android:textColor="#1F1F1F"
                            android:textSize="16sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="2dp"

                            android:text="Actualiza tu nombre"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="›"
                        android:textColor="#BBBBBB"
                        android:textSize="28sp" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="#F1F1F1" />


                <!-- ============================================= -->
                <!-- MIS PEDIDOS -->
                <!-- ============================================= -->

                <LinearLayout
                    android:id="@+id/opcionPedidosPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"

                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"

                    android:gravity="center_vertical"
                    android:orientation="horizontal"

                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">


                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:background="@drawable/bg_icono_perfil"

                        android:gravity="center"

                        android:text="▣"
                        android:textColor="#E87520"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="Mis pedidos"

                            android:textColor="#1F1F1F"
                            android:textSize="16sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="2dp"

                            android:text="Consulta tus pedidos realizados"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="›"
                        android:textColor="#BBBBBB"
                        android:textSize="28sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- BOTÓN CERRAR SESIÓN -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"

            android:layout_width="match_parent"
            android:layout_height="54dp"

            android:layout_marginTop="28dp"

            android:text="Cerrar sesión"
            android:textAllCaps="false"

            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"

            app:backgroundTint="#E87520"
            app:cornerRadius="16dp"
            app:strokeWidth="0dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>