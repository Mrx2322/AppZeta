<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/cardEntrada"

    android:layout_width="280dp"
    android:layout_height="112dp"

    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="false"

    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:baselineAligned="false"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:paddingStart="14dp"
        android:paddingEnd="12dp">


        <!-- ================================================= -->
        <!-- ICONO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"

            android:background="@drawable/bg_icono_perfil"

            android:contentDescription="@string/item_entrada_descripcion"

            android:gravity="center"

            android:text="@string/item_entrada_icono"
            android:textSize="22sp" />


        <!-- ================================================= -->
        <!-- INFORMACIÓN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"

            android:layout_weight="1"

            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombrePlato"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:ellipsize="end"
                android:maxLines="2"

                android:textColor="#202020"
                android:textSize="15sp"
                android:textStyle="bold"

                tools:text="Ceviche" />

            <TextView
                android:id="@+id/tvStockEntrada"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:ellipsize="end"
                android:maxLines="1"

                android:text="@string/item_entrada_stock_default"

                android:textColor="#757575"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BOTÓN AGREGAR -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarEntrada"

            android:layout_width="88dp"
            android:layout_height="48dp"

            android:layout_marginStart="4dp"

            android:minWidth="0dp"
            android:minHeight="48dp"

            android:paddingStart="8dp"
            android:paddingEnd="8dp"

            android:text="@string/item_entrada_agregar"
            android:textAllCaps="false"

            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"

            app:backgroundTint="#E87520"
            app:cornerRadius="14dp"
            app:elevation="0dp" />


        <!-- ================================================= -->
        <!-- SELECTOR DE CANTIDAD -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutCantidadEntrada"

            android:layout_width="wrap_content"
            android:layout_height="48dp"

            android:layout_marginStart="4dp"

            android:gravity="center"
            android:orientation="horizontal"

            android:visibility="gone"

            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestarEntrada"

                android:layout_width="48dp"
                android:layout_height="48dp"

                android:minWidth="48dp"
                android:minHeight="48dp"

                android:padding="0dp"

                android:contentDescription="@string/entrada_restar_descripcion"

                android:text="@string/entrada_restar_simbolo"
                android:textAllCaps="false"

                android:textColor="#E87520"
                android:textSize="22sp"
                android:textStyle="bold"

                app:backgroundTint="#FFF1E7"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

            <TextView
                android:id="@+id/tvCantidadEntrada"

                android:layout_width="32dp"
                android:layout_height="48dp"

                android:gravity="center"

                android:textColor="#202020"
                android:textSize="16sp"
                android:textStyle="bold"

                tools:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSumarEntrada"

                android:layout_width="48dp"
                android:layout_height="48dp"

                android:minWidth="48dp"
                android:minHeight="48dp"

                android:padding="0dp"

                android:contentDescription="@string/entrada_sumar_descripcion"

                android:text="@string/entrada_sumar_simbolo"
                android:textAllCaps="false"

                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"

                app:backgroundTint="#E87520"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>