<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F7F7F7"

    android:clipChildren="false"
    android:clipToPadding="false"

    tools:context=".usuario.carrito.ActivityPedido">


    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEncabezadoPedido"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="18dp"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="18dp"

        app:cardBackgroundColor="#FFF3E8"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"

        app:strokeColor="#FFE0C2"
        app:strokeWidth="1dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:baselineAligned="false"

            android:gravity="center_vertical"
            android:orientation="horizontal"

            android:paddingStart="18dp"
            android:paddingTop="15dp"
            android:paddingEnd="16dp"
            android:paddingBottom="15dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/carrito_titulo"

                    android:textColor="#202020"
                    android:textSize="27sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvTotalProductos"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="@string/carrito_productos_cero"

                    android:textColor="#766B64"
                    android:textSize="14sp" />

            </LinearLayout>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"

                android:layout_marginStart="12dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">


                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"

                    android:layout_gravity="center"

                    android:contentDescription="@string/carrito_descripcion"

                    android:src="@drawable/ic_carrito" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- CONTENEDOR DE PRODUCTOS -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/contenedorPedido"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"

        app:layout_constraintTop_toBottomOf="@id/cardEncabezadoPedido"
        app:layout_constraintBottom_toTopOf="@id/cardResumenPedido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPedido"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:clipToPadding="false"
            android:overScrollMode="never"

            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"

            android:scrollbars="none"

            tools:listitem="@layout/item_pedido" />


        <!-- ================================================= -->
        <!-- PEDIDO VACÍO -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/tvMensajeVacio"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"
            android:orientation="vertical"

            android:padding="28dp"

            android:visibility="gone">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="76dp"
                android:layout_height="76dp"

                app:cardBackgroundColor="#FFF3E8"
                app:cardCornerRadius="38dp"
                app:cardElevation="0dp">


                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"

                    android:layout_gravity="center"

                    android:contentDescription="@string/carrito_vacio_descripcion"

                    android:src="@drawable/ic_carrito" />

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:gravity="center"

                android:text="@string/carrito_vacio_titulo"

                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:gravity="center"

                android:text="@string/carrito_vacio_subtitulo"

                android:textColor="#888888"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- RESUMEN -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResumenPedido"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"

        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp"

        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:baselineAligned="false"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/carrito_total_titulo"

                        android:textColor="#777777"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/tvTotalPedido"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="@string/carrito_total_default"

                        android:textColor="#202020"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/carrito_todo_listo"

                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuar"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="11dp"

                android:minHeight="48dp"

                android:text="@string/carrito_continuar"

                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"

                app:backgroundTint="#E87520"
                app:cornerRadius="16dp"
                app:elevation="0dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- BARRA INFERIOR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:minHeight="76dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"

        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:baselineAligned="false"

            android:clipChildren="false"
            android:clipToPadding="false"

            android:gravity="center"
            android:orientation="horizontal"

            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp">


            <!-- INICIO -->

            <LinearLayout
                android:id="@+id/navInicio"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_inicio"

                    android:src="@drawable/ic_home" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_inicio"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- EXTRAS -->

            <LinearLayout
                android:id="@+id/navExtras"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_extras"

                    android:src="@drawable/ic_extra" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_extras"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- PEDIDOS -->

            <LinearLayout
                android:id="@+id/navPedidos"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_pedidos"

                    android:src="@drawable/ic_pedidos" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_pedidos"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- CARRITO -->

            <LinearLayout
                android:id="@+id/navCarrito"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp">


                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp">


                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"

                        android:layout_gravity="center"

                        android:contentDescription="@string/cd_carrito"

                        android:src="@drawable/ic_carrito" />


                    <TextView
                        android:id="@+id/tvCantidadCarrito"

                        android:layout_width="18dp"
                        android:layout_height="18dp"

                        android:layout_gravity="top|end"

                        android:background="@drawable/bg_badge_carrito"

                        android:gravity="center"

                        android:text="@string/contador_cero"

                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </FrameLayout>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="1dp"

                    android:gravity="center"

                    android:text="@string/nav_carrito"

                    android:textColor="#E87520"
                    android:textSize="11sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="18dp"
                    android:layout_height="3dp"

                    android:layout_marginTop="3dp"

                    android:background="@drawable/bg_nav_indicator" />

            </LinearLayout>


            <!-- PERFIL -->

            <LinearLayout
                android:id="@+id/navPerfil"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:minHeight="72dp"

                android:orientation="vertical"

                android:paddingTop="9dp"
                android:paddingBottom="7dp"

                tools:ignore="UseCompoundDrawables">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/cd_perfil"

                    android:src="@drawable/ic_perfil" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:gravity="center"

                    android:text="@string/nav_perfil"

                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>