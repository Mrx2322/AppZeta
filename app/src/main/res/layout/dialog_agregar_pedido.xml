<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:background="@drawable/bg_dialog_pedido"

    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">


        <!-- ================================================= -->
        <!-- ICONO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"

            android:layout_gravity="center_horizontal"

            android:background="@drawable/bg_icono_pedido"

            android:contentDescription="@string/dialog_pedido_cd_agregar"

            android:gravity="center"

            android:text="@string/dialog_pedido_icono"
            android:textSize="28sp" />


        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTituloPedido"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:gravity="center"

            android:text="@string/dialog_pedido_titulo"

            android:textColor="#202020"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- NOMBRE DEL PLATO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvNombrePlato"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"

            android:text="@string/dialog_pedido_nombre_default"

            android:textColor="#E87520"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- INFORMACIÓN DE PRECIOS -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="#FFF8F2"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"

            app:strokeColor="#FFE0C2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="14dp">


                <!-- SIN ENTRADA -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:baselineAligned="false"

                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="@string/dialog_pedido_sin_entrada"

                        android:textColor="#555555"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrecioSinEntrada"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/dialog_pedido_precio_sin_entrada"

                        android:textColor="#202020"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- CON ENTRADA -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:baselineAligned="false"

                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="@string/dialog_pedido_con_entrada"

                        android:textColor="#555555"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrecioConEntrada"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/dialog_pedido_precio_con_entrada"

                        android:textColor="#E87520"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ENTRADA ADICIONAL -->

                <TextView
                    android:id="@+id/tvPrecioEntradaAdicional"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="9dp"

                    android:text="@string/dialog_pedido_entrada_adicional"

                    android:textColor="#7A6A60"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- SELECCIÓN ACTUAL -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"

            app:strokeColor="#E7E7E7"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/dialog_pedido_tu_seleccion"

                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvEntradasSeleccionadas"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="@string/dialog_pedido_sin_entrada"

                    android:textColor="#252525"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="12dp"

                    android:background="#EEEEEE" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="11dp"

                    android:baselineAligned="false"

                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="@string/dialog_pedido_total_seleccion"

                        android:textColor="#555555"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/tvTotalSeleccion"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/dialog_pedido_precio_sin_entrada"

                        android:textColor="#E87520"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- AYUDA -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvAyudaSeleccion"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:gravity="center"

            android:text="@string/dialog_pedido_ayuda_sin_entrada"

            android:textColor="#888888"
            android:textSize="12sp" />


        <!-- ================================================= -->
        <!-- BOTONES -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:baselineAligned="false"

            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarPedido"

                android:layout_width="0dp"
                android:layout_height="50dp"

                android:layout_weight="1"

                android:minWidth="0dp"

                android:text="@string/dialog_pedido_cancelar"
                android:textAllCaps="false"

                android:textColor="#666666"
                android:textSize="14sp"

                app:backgroundTint="#EEEEEE"
                app:cornerRadius="14dp"
                app:elevation="0dp" />


            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarPedido"

                android:layout_width="0dp"
                android:layout_height="50dp"

                android:layout_weight="1"

                android:minWidth="0dp"

                android:text="@string/dialog_pedido_agregar"
                android:textAllCaps="false"

                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"

                app:backgroundTint="#E87520"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>