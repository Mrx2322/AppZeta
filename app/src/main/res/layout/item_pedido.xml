<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginTop="5dp"
    android:layout_marginBottom="7dp"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"

    app:strokeColor="#ECECEC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="13dp">


        <!-- ================================================= -->
        <!-- INFORMACIÓN DEL PRODUCTO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:baselineAligned="false"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- IMAGEN -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"

                app:cardBackgroundColor="#FFF5EC"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@drawable/fondo_menu"

                    android:contentDescription="@string/item_pedido_producto_descripcion"

                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>


            <!-- DATOS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="13dp"

                android:layout_weight="1"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreProducto"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:ellipsize="end"
                    android:maxLines="2"

                    android:text="@string/item_pedido_nombre_default"

                    android:textColor="#202020"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvDetalleProducto"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:ellipsize="end"
                    android:maxLines="2"

                    android:text="@string/item_pedido_detalle_default"

                    android:textColor="#6F625A"
                    android:textSize="12sp"

                    android:visibility="gone" />


                <TextView
                    android:id="@+id/tvPrecioProducto"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="@string/item_pedido_precio_default"

                    android:textColor="#777777"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ELIMINAR -->

            <ImageButton
                android:id="@+id/btnEliminar"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:layout_marginStart="4dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="@string/item_pedido_eliminar_descripcion"

                android:padding="10dp"

                android:src="@android:drawable/ic_menu_delete"

                app:tint="#D85B4B" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DIVISOR -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"

            android:layout_marginTop="11dp"
            android:layout_marginBottom="10dp"

            android:background="#F0F0F0" />


        <!-- ================================================= -->
        <!-- CANTIDAD Y SUBTOTAL -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:baselineAligned="false"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- DISMINUIR -->

            <ImageButton
                android:id="@+id/btnMenos"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="@string/item_pedido_disminuir_descripcion"

                android:padding="11dp"

                android:src="@android:drawable/ic_media_previous"

                app:tint="#E87520" />


            <!-- CANTIDAD -->

            <TextView
                android:id="@+id/tvCantidad"

                android:layout_width="44dp"
                android:layout_height="42dp"

                android:gravity="center"

                android:text="@string/item_pedido_cantidad_inicial"

                android:textColor="#202020"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- AUMENTAR -->

            <ImageButton
                android:id="@+id/btnMas"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="@string/item_pedido_aumentar_descripcion"

                android:padding="10dp"

                android:src="@android:drawable/ic_input_add"

                app:tint="#E87520" />


            <!-- SUBTOTAL -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="10dp"

                android:layout_weight="1"

                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/item_pedido_subtotal"

                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSubtotalProducto"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="1dp"

                    android:text="@string/item_pedido_subtotal_default"

                    android:textColor="#202020"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>