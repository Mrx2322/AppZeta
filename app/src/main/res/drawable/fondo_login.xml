<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFF7F0"
                android:startColor="#FFFDF9"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:width="230dp"
        android:height="230dp"
        android:gravity="top|end"
        android:top="-80dp"
        android:right="-65dp">

        <shape android:shape="oval">
            <solid android:color="#18E87520" />
        </shape>
    </item>

    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="bottom|start"
        android:bottom="-70dp"
        android:left="-55dp">

        <shape android:shape="oval">
            <solid android:color="#12F2A65A" />
        </shape>
    </item>

</layer-list>