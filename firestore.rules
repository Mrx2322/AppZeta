
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FUNCIONES BASE
    // =========================================================

    function sesionIniciada() {
      return request.auth != null;
    }

    function esAnonimo() {
      return sesionIniciada()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function esPropietario(uid) {
      return sesionIniciada()
        && request.auth.uid == uid;
    }

    function rutaAdministrador() {
      return /databases/$(database)/documents/administradores/$(request.auth.uid);
    }

    function esAdministrador() {
      return sesionIniciada()
        && exists(rutaAdministrador())
        && get(rutaAdministrador()).data.activo == true
        && get(rutaAdministrador()).data.rol == 'admin';
    }

    function textoEntre(valor, minimo, maximo) {
      return valor is string
        && valor.size() >= minimo
        && valor.size() <= maximo;
    }

    function textoHasta(valor, maximo) {
      return valor is string
        && valor.size() <= maximo;
    }

    function numeroPositivo(valor) {
      return (valor is int || valor is float)
        && valor > 0;
    }


    // =========================================================
    // VALIDACIÃ“N MENÃš
    // =========================================================

    function menuValido() {
      return request.resource.data.keys().hasAll([
          'id', 'nombre', 'precio', 'stock'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'nombre', 'precio', 'stock'
        ])
        && request.resource.data.id is int
        && request.resource.data.id > 0
        && textoEntre(request.resource.data.nombre, 1, 100)
        && numeroPositivo(request.resource.data.precio)
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
    }


    // =========================================================
    // VALIDACIÃ“N ENTRADAS
    // =========================================================

    function entradaValida() {
      return request.resource.data.keys().hasAll([
          'id', 'nombre', 'disponible', 'stock'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'nombre', 'disponible', 'stock'
        ])
        && request.resource.data.id is int
        && request.resource.data.id > 0
        && textoEntre(request.resource.data.nombre, 1, 100)
        && request.resource.data.disponible is bool
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
    }


    // =========================================================
    // VALIDACIÃ“N EXTRAS
    // =========================================================

    function extraValido() {
      return request.resource.data.keys().hasAll([
          'id', 'nombre', 'precio', 'categoriaId', 'icono'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'nombre', 'precio', 'categoriaId', 'icono'
        ])
        && request.resource.data.id is int
        && request.resource.data.id > 0
        && textoEntre(request.resource.data.nombre, 1, 100)
        && numeroPositivo(request.resource.data.precio)
        && request.resource.data.categoriaId is int
        && request.resource.data.categoriaId in [1, 2, 3]
        && request.resource.data.icono is int;
    }


    // =========================================================
    // VALIDACIÃ“N CENAS
    // =========================================================

    function cenaValida() {
      return request.resource.data.keys().hasAll([
          'id', 'nombre', 'precio', 'stock'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'nombre', 'precio', 'stock'
        ])
        && request.resource.data.id is int
        && request.resource.data.id > 0
        && textoEntre(request.resource.data.nombre, 1, 100)
        && numeroPositivo(request.resource.data.precio)
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
    }


    // =========================================================
    // IDENTIDAD DEL USUARIO
    // =========================================================

    function identidadUsuarioValida() {
      let datos = request.resource.data;

      return (
        esAnonimo()
        && (!('correo' in datos) || datos.correo == '')
        && (!('email' in datos) || datos.email == '')
        && (!('esInvitado' in datos) || datos.esInvitado == true)
      )
      ||
      (
        !esAnonimo()
        && (
          !('correo' in datos)
          || (
            request.auth.token.email is string
            && datos.correo == request.auth.token.email
          )
        )
        && (
          !('email' in datos)
          || (
            request.auth.token.email is string
            && datos.email == request.auth.token.email
          )
        )
        && (!('esInvitado' in datos) || datos.esInvitado == false)
      );
    }


    // =========================================================
    // ACTUALIZACIÃ“N PROPIA DEL PERFIL
    // =========================================================

    function actualizacionPropiaUsuarioValida() {
      let datos = request.resource.data;

      return datos.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'correo', 'email'
        ])
        && textoEntre(datos.nombre, 1, 100)
        && (
          !('correo' in datos)
          || (
            datos.correo is string
            && datos.correo.size() <= 254
            && (
              (esAnonimo() && datos.correo == '')
              ||
              (
                !esAnonimo()
                && request.auth.token.email is string
                && datos.correo == request.auth.token.email
              )
            )
          )
        )
        && (
          !('email' in datos)
          || (
            datos.email is string
            && datos.email.size() <= 254
            && (
              (esAnonimo() && datos.email == '')
              ||
              (
                !esAnonimo()
                && request.auth.token.email is string
                && datos.email == request.auth.token.email
              )
            )
          )
        );
    }


    // =========================================================
    // VALIDACIÃ“N DEL CORREO DEL PEDIDO
    // =========================================================

    function correoPedidoValido() {
      return (
        esAnonimo()
        && request.resource.data.correo == ''
      )
      ||
      (
        !esAnonimo()
        && request.auth.token.email is string
        && request.resource.data.correo == request.auth.token.email
      );
    }


    // =========================================================
    // GPS OPCIONAL
    // =========================================================

    function ubicacionGpsValida() {
      let tieneLatitud = 'latitud' in request.resource.data;
      let tieneLongitud = 'longitud' in request.resource.data;
      let tieneMaps = 'ubicacionMaps' in request.resource.data;

      let sinGps = !tieneLatitud && !tieneLongitud && !tieneMaps;

      let conGps = tieneLatitud
        && tieneLongitud
        && tieneMaps
        && (
          request.resource.data.latitud is int
          || request.resource.data.latitud is float
        )
        && (
          request.resource.data.longitud is int
          || request.resource.data.longitud is float
        )
        && request.resource.data.latitud >= -90
        && request.resource.data.latitud <= 90
        && request.resource.data.longitud >= -180
        && request.resource.data.longitud <= 180
        && request.resource.data.ubicacionMaps is string
        && request.resource.data.ubicacionMaps.size() > 0
        && request.resource.data.ubicacionMaps.size() <= 500;

      return (
        request.resource.data.tipoEntrega == 'Delivery'
        && (sinGps || conGps)
      )
      ||
      (
        request.resource.data.tipoEntrega == 'Recojo en tienda'
        && sinGps
      );
    }


    // =========================================================
    // ADMINISTRADORES
    // =========================================================

    match /administradores/{adminId} {
      allow get: if esPropietario(adminId);
      allow list: if false;
      allow create, update, delete: if false;
    }


    // =========================================================
    // USUARIOS
    // =========================================================

    match /usuarios/{usuarioId} {
      allow create: if esPropietario(usuarioId)
        && request.resource.data.keys().hasAll(['nombre'])
        && request.resource.data.keys().hasOnly([
          'uid', 'nombre', 'correo', 'email', 'esInvitado',
          'privacidadVersion', 'privacidadAceptadaEn'
        ])
        && (
          !('uid' in request.resource.data)
          || request.resource.data.uid == request.auth.uid
        )
        && textoEntre(request.resource.data.nombre, 1, 100)
        && (
          !('correo' in request.resource.data)
          || textoHasta(request.resource.data.correo, 254)
        )
        && (
          !('email' in request.resource.data)
          || textoHasta(request.resource.data.email, 254)
        )
        && (
          !('esInvitado' in request.resource.data)
          || request.resource.data.esInvitado is bool
        )
        && (
          !('privacidadVersion' in request.resource.data)
          || request.resource.data.privacidadVersion == '2026-10-15'
        )
        && (
          !('privacidadAceptadaEn' in request.resource.data)
          || (
            request.resource.data.privacidadVersion == '2026-10-15'
            && request.resource.data.privacidadAceptadaEn is timestamp
            && request.resource.data.privacidadAceptadaEn == request.time
          )
        )
        && identidadUsuarioValida();

      allow get: if esPropietario(usuarioId) || esAdministrador();
      allow list: if esAdministrador();

      allow update: if esAdministrador()
        || (
          esPropietario(usuarioId)
          && actualizacionPropiaUsuarioValida()
        );

      allow delete: if esAdministrador();
    }


    // =========================================================
    // MENÃš
    // =========================================================

    match /menu/{menuId} {
      allow read: if sesionIniciada();
      allow create, update: if esAdministrador() && menuValido();
      allow delete: if esAdministrador();
    }

    match /entradas/{entradaId} {
      allow read: if sesionIniciada();
      allow create, update: if esAdministrador() && entradaValida();
      allow delete: if esAdministrador();
    }

    match /extras/{extraId} {
      allow read: if sesionIniciada();

      allow create: if esAdministrador() && extraValido();
      allow update: if esAdministrador() && extraValido();
      allow delete: if esAdministrador();
    }


    // =========================================================
    // CENAS
    // =========================================================

    match /cenas/{cenaId} {
      allow read: if sesionIniciada();
      allow create, update: if esAdministrador() && cenaValida();
      allow delete: if esAdministrador();
    }

    match /solicitudesPedidos/{solicitudId} {
      allow create: if sesionIniciada()
        && request.resource.data.keys().hasAll([
          'usuarioId', 'nombreUsuario', 'correo', 'productos', 'totalEstimado',
          'tipoEntrega', 'direccion', 'referencia', 'telefono', 'observacion',
          'metodoPago', 'estado', 'fecha'
        ])
        && request.resource.data.keys().hasOnly([
          'usuarioId', 'nombreUsuario', 'correo', 'productos', 'totalEstimado',
          'tipoEntrega', 'direccion', 'referencia', 'telefono', 'observacion',
          'metodoPago', 'estado', 'fecha', 'latitud', 'longitud', 'ubicacionMaps',
          'privacidadVersion', 'privacidadAceptadaEn'
        ])
        && request.resource.data.usuarioId == request.auth.uid
        && textoEntre(request.resource.data.nombreUsuario, 1, 100)
        && request.resource.data.correo is string
        && request.resource.data.correo.size() <= 254
        && request.resource.data.productos is list
        && request.resource.data.productos.size() > 0
        && request.resource.data.productos.size() <= 100
        && numeroPositivo(request.resource.data.totalEstimado)
        && request.resource.data.tipoEntrega in ['Delivery', 'Recojo en tienda']
        && request.resource.data.direccion is string
        && request.resource.data.direccion.size() <= 300
        && request.resource.data.referencia is string
        && request.resource.data.referencia.size() <= 300
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 25
        && request.resource.data.observacion is string
        && request.resource.data.observacion.size() <= 500
        && (
          (request.resource.data.tipoEntrega == 'Delivery'
            && request.resource.data.direccion.size() > 0
            && request.resource.data.telefono.size() > 0)
          ||
          (request.resource.data.tipoEntrega == 'Recojo en tienda'
            && request.resource.data.direccion == 'Recojo en tienda')
        )
        && request.resource.data.metodoPago == 'Contra entrega'
        && request.resource.data.estado == 'Pendiente de aprobacion'
        && request.resource.data.fecha is timestamp
        && request.resource.data.fecha == request.time
        && (
          !('privacidadVersion' in request.resource.data)
          || request.resource.data.privacidadVersion == '2026-10-15'
        )
        && (
          !('privacidadAceptadaEn' in request.resource.data)
          || (
            request.resource.data.privacidadVersion == '2026-10-15'
            && request.resource.data.privacidadAceptadaEn is timestamp
            && request.resource.data.privacidadAceptadaEn == request.time
          )
        )
        && ubicacionGpsValida();

      allow get, list: if esAdministrador()
        || (sesionIniciada() && resource.data.usuarioId == request.auth.uid);

      allow update: if esAdministrador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'motivoRevision', 'numeroPedido', 'totalConfirmado', 'fechaRevision'
        ])
        && request.resource.data.estado in ['Aprobada', 'Rechazada'];

      allow delete: if esAdministrador();
    }

    match /pedidos/{pedidoId} {
      allow create, update, delete: if esAdministrador();
      allow read: if esAdministrador()
        || (sesionIniciada() && resource.data.usuarioId == request.auth.uid);
    }

    match /configuracion/contadorPedidos {
      allow read: if esAdministrador();
      allow create, update: if esAdministrador()
        && request.resource.data.keys().hasOnly(['ultimoNumero'])
        && request.resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero >= 0;
      allow delete: if esAdministrador();
    }


    // =========================================================
    // DENEGAR TODAS LAS DEMÃS COLECCIONES
    // =========================================================

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}

